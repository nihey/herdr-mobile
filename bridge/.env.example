# Leave unset to discover tailscale ip -4; use 127.0.0.1 for local-only tests.
# HERDR_MOBILE_HOST=100.x.x.x
HERDR_MOBILE_PORT=8787
# Defaults to ~/.config/herdr/herdr.sock. Set this for a named Herdr session.
# HERDR_SOCKET_PATH=/absolute/path/to/herdr.sock
# Generated automatically when absent. Relative paths are resolved from bridge/.
HERDR_MOBILE_TOKEN_FILE=../.local/pairing-token
# Optional explicit token (at least 32 characters); do not commit it.
# HERDR_MOBILE_TOKEN=
